APP_NAME=Xpost
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
XPOST_LOG_LEVEL=info
XPOST_LOG_DAYS=30

# ---------------------------------------------------------------------------
# MySQL 8.4 (docker-compose service: mysql)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xpost
DB_USERNAME=xpost
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Redis 8.10 (docker-compose service: redis)
# ---------------------------------------------------------------------------
# predis is the pure-PHP client and needs no extension; switch to phpredis on
# the Ubuntu server (apt install php8.5-redis) for noticeably lower latency
# under the publish queue's job volume.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ---------------------------------------------------------------------------
# Queue / cache / session -- all on Redis so Horizon and the locks work
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log

HORIZON_PREFIX=xpost_horizon:

# ---------------------------------------------------------------------------
# SPA auth (Sanctum). Must list every origin the SPA is served from.
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Media storage. `local` for dev; S3-compatible (or MinIO) in production so
# every worker node can read the same files during chunked upload.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# ClickHouse (docker-compose service: clickhouse). Optional -- with it off,
# analytics fall back to MySQL aggregates.
# ---------------------------------------------------------------------------
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=xpost

# ---------------------------------------------------------------------------
# Xpost tuning
# ---------------------------------------------------------------------------
# Per-account daily post cap. The single most important anti-spam lever --
# raise it slowly and only for accounts with a clean history.
XPOST_ACCOUNT_DAILY_CAP=50
# Per-app daily cap. Must match the tier you actually pay for.
XPOST_APP_DAILY_CAP=100
XPOST_APP_BURST_15MIN=300
XPOST_MAX_TARGETS_PER_POST=20000
XPOST_DISPATCH_LIMIT=1000
XPOST_CLAIM_LEASE_MINUTES=15
XPOST_MAX_ATTEMPTS=5

XPOST_MAX_ACCOUNTS_PER_TEAM=10000
XPOST_MAX_ACCOUNTS_PER_APP=500
XPOST_MAX_ACCOUNTS_PER_PROXY=50
XPOST_COOLDOWN_AFTER_FAILURES=3
XPOST_DISABLE_AFTER_FAILURES=10

XPOST_HTTP_TIMEOUT=30
XPOST_HTTP_CONNECT_TIMEOUT=10
XPOST_MAX_UPLOAD_MB=512

XPOST_METRICS_LOOKBACK_HOURS=72
XPOST_METRICS_ACCOUNTS_PER_RUN=1000
XPOST_METRICS_FLUSH_SIZE=5000

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="xpost@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
